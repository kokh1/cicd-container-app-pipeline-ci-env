#this is reference documenation for the config.toml file in the runner-config subdirectory of the gitlab directory
#the config.toml will be auto-generated when the runner is registered
#see the README.md in the main project directory for instructions on making required edits to the config.toml
#in a real version, the should be no leading blank lines and the start of the document and no comment lines anywhere in the document

concurrent = 1
check_interval = 0
connection_max_age = "15m0s"
shutdown_timeout = 0
listen_address = "0.0.0.0:9252"

[session_server]
  session_timeout = 1800

[[runners]]
  name = "gitlab-runner"
  url = "http://gitlab/"
  id = 4
  token = "<YourRunnerRegistrationTokenWillAppearHere>"
  token_obtained_at = 2025-11-11T20:52:53Z
  token_expires_at = 0001-01-01T00:00:00Z
  executor = "docker"
  [runners.cache]
    MaxUploadedArchiveSize = 0
    [runners.cache.s3]
    [runners.cache.gcs]
    [runners.cache.azure]
  [runners.docker]
    tls_verify = false
    image = "docker:latest"
    privileged = false
    disable_entrypoint_overwrite = false
    oom_kill_disable = false
    network_mode = "gitlab-network"
    disable_cache = false
    volumes = ["/var/run/docker.sock:/var/run/docker.sock", "/cache"]
    shm_size = 0
    network_mtu = 0
